# Docker Compose settings for the local pgvector-enabled PostgreSQL container.
POSTGRES_USER=talentmatch
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=talentmatch
POSTGRES_PORT=5432

# Keep these values aligned with POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB above.
DATABASE_URL="postgresql://talentmatch:replace-with-a-long-local-password@localhost:5432/talentmatch?schema=public"

# Ollama embedding provider defaults (no model download is performed by the app).
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Optional Ollama instruction model for evidence-grounded explanations.
# Set this to a model already available in your local Ollama installation.
EXPLANATION_MODEL=
EXPLANATION_TIMEOUT_MS=30000

# Reciprocal Rank Fusion smoothing constant (used only for hybrid retrieval).
RETRIEVAL_RRF_K=60

# NODE_ENV is set by Next.js during development and production.
